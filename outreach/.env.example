# --- Zugang zum Tool (Basic Auth, Pflicht) ---
ADMIN_USER=admin
ADMIN_PASS=bitte-aendern

# Öffentliche URL des Tools (für Abmeldelinks in Mails)
PUBLIC_URL=https://outreach.hk-growthoperator.de
PORT=3100
DB_PATH=./data/outreach.db

# --- Absender / Pflichtangaben im Footer (§5 DDG) ---
SENDER_NAME=Hamid K. – HK Growth Operator
SENDER_IMPRINT=HK Growth Operator · Musterstraße 1 · 12345 Musterstadt · info@hk-growthoperator.de · hk-growthoperator.de/impressum
REPLY_TO=info@hk-growthoperator.de

# --- SMTP-Postfächer (JSON-Liste). Jedes Postfach hat sein eigenes Tageslimit. ---
# Tipp: separate Outreach-Domain (z. B. hk-growth-mail.de) mit SPF, DKIM, DMARC,
# damit die Hauptdomain nie auf einer Blacklist landet.
SMTP_ACCOUNTS=[{"host":"smtp.example.com","port":465,"secure":true,"user":"anna@hk-growth-mail.de","pass":"xxx","from":"Anna von HK Growth <anna@hk-growth-mail.de>","dailyLimit":150}]

# --- Versandsteuerung ---
DAILY_LIMIT=1000          # globales Tageslimit über alle Postfächer
WARMUP_START=20           # Start-Volumen pro Postfach am Tag 1
WARMUP_GROWTH=1.25        # +25 % pro Versandtag bis zum Postfach-Limit
MIN_DELAY_SEC=45          # Pause zwischen zwei Mails (zufällig zwischen MIN und MAX)
MAX_DELAY_SEC=120
SEND_DAYS=1,2,3,4,5       # Mo–Fr
SEND_HOURS=8-17           # Europe/Berlin
MAX_FAILURE_RATE=0.05     # Kampagne pausiert automatisch über 5 % Fehler/Bounces

# --- Rechtsgrundlage (siehe README!) ---
# false (Standard): E-Mails nur an Leads mit dokumentierter Einwilligung / Anfrage / Bestandskunde.
#                   Kalte Leads gehen in die Telefon-/Brief-Exportliste.
# true:             Auch Leads ohne Rechtsgrundlage dürfen angemailt werden. Abmahnrisiko nach §7 UWG trägst du.
ALLOW_COLD_EMAIL=false

# Testmodus: nichts wird wirklich verschickt, nur geloggt
DRY_RUN=true
